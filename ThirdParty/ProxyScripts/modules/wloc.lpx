#!name=Floc WLOC (Loon)
#!desc=配合「Floc」应用改写 Apple 定位服务响应。本文件适用于 Loon。
#!author=Floc
#!homepage=https://github.com/Lululu-0715/Floc

# ─────────────────────────────────────────────────────────────
#  本文件仅供 Loon 导入。
#  格式特征：#!name= 开头的插件格式，[Script] 段用 script-path= 声明。
#
#  其他客户端请改用对应文件（功能完全一致，只是格式不同）：
#    Shadowrocket    → wloc.module
#    Surge / Egern   → wloc.sgmodule
#    Quantumult X    → wloc.conf
#    Stash           → wloc.stoverride
#  对照表见同目录的 README.md
#
#  导入后请开启本模块，并确认 MITM 已启用。切勿给下方主机名添加
#  DIRECT 规则——那会让流量绕过代理，规则永远不会触发。
# ─────────────────────────────────────────────────────────────

[Script]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/Lululu-0715/Floc/main/ThirdParty/ProxyScripts/wloc.js, requires-body=true, max-size=1048576, tag=WLOC 定位改写
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://raw.githubusercontent.com/Lululu-0715/Floc/main/ThirdParty/ProxyScripts/wloc-settings.js, requires-body=false, tag=WLOC 配置接口

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
